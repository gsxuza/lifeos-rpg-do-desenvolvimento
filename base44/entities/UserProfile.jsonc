{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "xp_next_level": {
      "type": "number",
      "default": 1000
    },
    "title": {
      "type": "string",
      "default": "Iniciante"
    },
    "avatar_class": {
      "type": "string",
      "enum": [
        "Estrategista",
        "Empreendedor",
        "S\u00e1bio",
        "Guardi\u00e3o"
      ],
      "default": "Estrategista"
    },
    "energy": {
      "type": "number",
      "default": 80
    },
    "wisdom_xp": {
      "type": "number",
      "default": 0
    },
    "craft_xp": {
      "type": "number",
      "default": 0
    },
    "vitality_xp": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "skills": {
      "type": "object",
      "properties": {
        "lideranca": {
          "type": "number",
          "default": 30
        },
        "comunicacao": {
          "type": "number",
          "default": 40
        },
        "tecnico": {
          "type": "number",
          "default": 50
        },
        "financas": {
          "type": "number",
          "default": 20
        },
        "criatividade": {
          "type": "number",
          "default": 35
        },
        "bem_estar": {
          "type": "number",
          "default": 45
        }
      }
    },
    "risk_profile": {
      "type": "string",
      "enum": [
        "Conservador",
        "Moderado",
        "Arrojado"
      ],
      "default": "Moderado"
    }
  },
  "required": []
}