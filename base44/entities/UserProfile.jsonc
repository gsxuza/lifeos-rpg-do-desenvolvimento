{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "xp_next_level": {
      "type": "number",
      "default": 1000
    },
    "title": {
      "type": "string",
      "default": "Iniciante"
    },
    "avatar_class": {
      "type": "string",
      "enum": [
        "Estrategista",
        "Empreendedor",
        "S\u00e1bio",
        "Guardi\u00e3o"
      ],
      "default": "Estrategista"
    },
    "energy": {
      "type": "number",
      "default": 80
    },
    "wisdom_xp": {
      "type": "number",
      "default": 0
    },
    "craft_xp": {
      "type": "number",
      "default": 0
    },
    "vitality_xp": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "skills": {
      "type": "object",
      "properties": {
        "lideranca": {
          "type": "number",
          "default": 30
        },
        "comunicacao": {
          "type": "number",
          "default": 40
        },
        "tecnico": {
          "type": "number",
          "default": 50
        },
        "financas": {
          "type": "number",
          "default": 20
        },
        "criatividade": {
          "type": "number",
          "default": 35
        },
        "bem_estar": {
          "type": "number",
          "default": 45
        }
      }
    },
    "risk_profile": {
      "type": "string",
      "enum": [
        "Conservador",
        "Moderado",
        "Arrojado"
      ],
      "default": "Moderado"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "archetype": {
      "type": "string",
      "enum": [
        "Poupador",
        "Transi\u00e7\u00e3o de Carreira",
        "H\u00e1bitos Saud\u00e1veis"
      ],
      "default": "H\u00e1bitos Saud\u00e1veis"
    },
    "daily_hours": {
      "type": "number",
      "default": 1
    },
    "ai_tone": {
      "type": "string",
      "enum": [
        "motivador",
        "anal\u00edtico",
        "r\u00edgido"
      ],
      "default": "motivador"
    },
    "open_finance_connected": {
      "type": "boolean",
      "default": false
    },
    "open_finance_token": {
      "type": "string"
    },
    "open_finance_last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "calendar_connected": {
      "type": "boolean",
      "default": false
    },
    "calendar_token": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "spending_limits": {
      "type": "object",
      "properties": {
        "lazer": {
          "type": "number",
          "default": 500
        },
        "alimentacao": {
          "type": "number",
          "default": 1200
        },
        "transporte": {
          "type": "number",
          "default": 400
        }
      }
    }
  },
  "required": []
}